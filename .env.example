# App Configuration
VITE_APP_ID=ai-job-hunter
NODE_ENV=development
PORT=3000

# Security (generate a random 32+ character string for JWT_SECRET)
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars

# Database (MySQL connection string)
DATABASE_URL=mysql://user:password@localhost:3306/job_hunter

# Google OAuth (get these from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
APP_URL=http://localhost:5173

# Owner ID (your Google user ID after first login)
OWNER_OPEN_ID=google-user-id

# Optional: Forge API for storage and LLM
BUILT_IN_FORGE_API_URL=https://forge.example.com
BUILT_IN_FORGE_API_KEY=your-forge-api-key

# Job APIs (at least one recommended)
ADZUNA_APP_ID=47b7e6b5
ADZUNA_APP_KEY=bbf0d7d75482b846e294f6d09508a8a4
# JSEARCH_API_KEY=your-jsearch-api-key
