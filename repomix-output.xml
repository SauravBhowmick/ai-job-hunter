    if (profile) {
      setFormData({
        fullName: profile.fullName || user?.name || "",
        email: profile.email || user?.email || "",
        phone: profile.phone || "",
        location: profile.location || "",
        cvSummary: profile.cvSummary || "",
        skills: profile.skills || [],
