  APP_URL: z.string().url('APP_URL must be a valid URL'),
  
  OWNER_OPEN_ID: z.string().min(1, 'OWNER_OPEN_ID is required'),
  NODE_ENV: z.enum(['development', 'production', 'test']).default('development'),
